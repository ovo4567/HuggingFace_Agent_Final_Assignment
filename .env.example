# ─────────────────────────────────────────────────────────────────────
# GAIA Solver — environment variable template
#
# Copy to `.env` and fill in your own values. `.env` is gitignored and
# never committed. See README.md for the full table and HF Space secrets.
# ─────────────────────────────────────────────────────────────────────

# ── Required for live solves ─────────────────────────────────────────
# DeepSeek API key (ReAct Agent + answer-cleaning pass). Also set as an HF
# Space secret.
DEEPSEEK_API_KEY=

# Scoring server base URL (defaults to the course scoring server).
GAIA_API_URL=https://agents-course-unit4-scoring.hf.space

# ── HF Space (auto-set on the Space; set locally for informational prints)
SPACE_ID=ovo456/Final_Assignment_Template
SPACE_HOST=

# ── DeepSeek model config (optional) ─────────────────────────────────
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_AGENT_MODEL=deepseek-chat
DEEPSEEK_CLEANING_MODEL=deepseek-chat

# ── Local Run tuning (optional) ──────────────────────────────────────
GAIA_NUM_WORKERS=4
CLEANING_MAX_TOKENS=1024
# Two-stage per-Task timeout (Part B): at the soft deadline a best-effort
# Answer is synthesized from the partial Worklog (status 'forced', submitted);
# at the hard deadline the Task is terminated (status 'timeout', not submitted).
GAIA_TASK_SOFT_TIMEOUT=300
GAIA_TASK_HARD_TIMEOUT=360
# Bounds the forced-answer synthesis call so soft + synthesis stays < hard.
GAIA_FORCE_ANSWER_TIMEOUT=45
GAIA_RESULTS_CSV=gaia_results.csv
# ANSWER_BUNDLE_PATH=<repo>/answer_bundle.json

# ── Local multimodal (ADR-0002: local-only) ──────────────────────────
# Local compute device for Qwen vision + faster-whisper: auto | cpu | mps | cuda.
# 'auto' probes torch for an accelerator (Apple MPS first, then CUDA) and falls
# back to cpu. Note: faster-whisper clamps mps->cpu (CTranslate2 has no MPS).
LOCAL_DEVICE=auto
VISION_MODEL_ID=Qwen/Qwen2-VL-2B-Instruct
WHISPER_MODEL=tiny
# Set to 1 to prefer the hosted Whisper API over the local faster-whisper model.
USE_WHISPER_API=
VIDEO_FRAMES_COUNT=4
# VIDEO_FRAMES_DIR=<repo>/files/_video_frames

# ── Optional hosted audio fallback (Whisper) ─────────────────────────
# Only needed if you want the hosted transcription fallback. The endpoint
# and model are fixed by the code (OpenAI `whisper-1` or OpenRouter
# `openai/whisper-large-v3-turbo`) — only the keys below are configurable.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── HF tooling (local only, not read by the app) ─────────────────────
# For git pushes / `hf` CLI / downloading repos. Never a Space secret.
HUGGINGFACE_HUB_TOKEN=
# NOTE: the submission username comes from the HF OAuth profile at run
# time, not from an env var — there is no HF_USERNAME setting to fill in.
