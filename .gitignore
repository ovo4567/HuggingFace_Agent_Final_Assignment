# Secrets — never commit API keys (but do commit the .env.example template)
.env
.env.*
!.env.example

# Pre-downloaded benchmark Attachments (large; fetched by the server / local Run)
files/

# Agent-internal tooling & notes (skills, issue tracker, session handoffs) —
# kept out of the shared repo so it stays small and safe to share
.agents/
.scratch/
skills-lock.json
SESSION_HANDOFF.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Run outputs (regenerated each Run; the Answer bundle is committed instead)
gaia_results.csv

# OS / editor / logs
.DS_Store
.vscode/
*.log
